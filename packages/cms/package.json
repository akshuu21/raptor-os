{
  "name": "@raptor/cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Payload CMS content plane: publishable collections and globals for Raptor tenants. Owns cms_* tables only; never the domain schema.",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./payload.config.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "cms:generate-types": "payload generate:types",
    "cms:generate-importmap": "payload generate:importmap",
    "cms:migrate": "payload migrate",
    "cms:migrate-create": "payload migrate:create",
    "ci": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@raptor/auth": "workspace:*",
    "drizzle-orm": "0.45.4",
    "payload": "3.91.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
